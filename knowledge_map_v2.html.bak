          "prerequisites": ["e-firmware"],
          "topics": [
            { "id": "e-test-1", "name": "Test equipment (oscilloscopes, logic analyzers)", "priority": "core" },
            { "id": "e-test-2", "name": "Software debugging and trace", "priority": "core" },
            { "id": "e-test-3", "name": "Protocol debugging and analysis", "priority": "important" },
            { "id": "e-test-4", "name": "Environmental testing", "priority": "advanced" },
            { "id": "e-test-5", "name": "Compliance testing", "priority": "important" }
          ]
        }
      ]
    }
  ],
  "learningPaths": {
    "physics-beginner": {
      "name": "Physics Fundamentals",
      "description": "Start here if you're new to physics",
      "sequence": ["p-cm", "p-qm", "p-applied"]
    },
    "electronics-beginner": {
      "name": "Electronics Fundamentals", 
      "description": "Complete electronics learning path",
      "sequence": ["e-fundamentals", "e-analog", "e-digital", "e-microcontrollers", "e-firmware"]
    },
    "iot-developer": {
      "name": "IoT Developer Path",
      "description": "End-to-end IoT system development", 
      "sequence": ["e-fundamentals", "e-microcontrollers", "e-firmware", "e-comms-wireless", "e-sensors", "e-security"]
    },
    "embedded-engineer": {
      "name": "Embedded Systems Engineer",
      "description": "Professional embedded development",
      "sequence": ["e-analog", "e-digital", "e-microcontrollers", "e-firmware", "e-pcb"]
    },
    "math-foundations": {
      "name": "Mathematical Foundations",
      "description": "Essential math for science and engineering",
      "sequence": ["m-linalg", "m-calculus", "m-prob"]
    }
  }
};

let userProgress = {
  chapters: {}, // chapterId: { status: 'done'|'in-progress'|'not-started', notes: '', startedAt: timestamp }
  topics: {},   // topicId: { status: '', notes: '', completedAt: timestamp }
  lastUpdated: null
};

// Load user progress from localStorage
function loadKnowledgeBase() {
  // Data is already embedded above, just load user progress
  loadUserProgress();
  render();
}

// ============================================================
// LOCAL STORAGE & PERSISTENCE
// ============================================================

function loadUserProgress() {
  const saved = localStorage.getItem('knowledgeNavigator_progress');
  if (saved) {
    userProgress = JSON.parse(saved);
  }
}

function saveUserProgress() {
  userProgress.lastUpdated = Date.now();
  localStorage.setItem('knowledgeNavigator_progress', JSON.stringify(userProgress));
  updateProgressStats();
}

function getChapterStatus(chapterId) {
  return userProgress.chapters[chapterId]?.status || 'not-started';
}

function setChapterStatus(chapterId, status) {
  if (!userProgress.chapters[chapterId]) {
    userProgress.chapters[chapterId] = {};
  }
  userProgress.chapters[chapterId].status = status;
  if (status === 'done') {
    userProgress.chapters[chapterId].completedAt = Date.now();
  } else if (status === 'in-progress') {
    userProgress.chapters[chapterId].startedAt = Date.now();
  }
  saveUserProgress();
  render();
}

function getTopicStatus(topicId) {
  return userProgress.topics[topicId]?.status || 'not-started';
}

function setTopicStatus(topicId, status) {
  if (!userProgress.topics[topicId]) {
    userProgress.topics[topicId] = {};
  }
  userProgress.topics[topicId].status = status;
  if (status === 'done') {
    userProgress.topics[topicId].completedAt = Date.now();
  }
  saveUserProgress();
  render();
}

function getChapterNotes(chapterId) {
  return userProgress.chapters[chapterId]?.notes || '';
}

function setChapterNotes(chapterId, notes) {
  if (!userProgress.chapters[chapterId]) {
    userProgress.chapters[chapterId] = {};
  }
  userProgress.chapters[chapterId].notes = notes;
  saveUserProgress();
}

function getTopicNotes(topicId) {
  return userProgress.topics[topicId]?.notes || '';
}

function setTopicNotes(topicId, notes) {
  if (!userProgress.topics[topicId]) {
    userProgress.topics[topicId] = {};
  }
  userProgress.topics[topicId].notes = notes;
  saveUserProgress();
}

// ============================================================
// RENDERING
// ============================================================

function render() {
  renderSidebar();
  renderRoadmap();
  renderTree();
  renderList();
  updateProgressStats();
}

function renderSidebar() {
  const container = document.getElementById('sidebarContent');
  container.innerHTML = '';
  
  knowledgeBase.subjects.forEach(subject => {
    const section = document.createElement('div');
    section.className = 'subject-section';
    
    const header = document.createElement('div');
    header.className = 'subject-header';
    header.innerHTML = `
      <span class="subject-icon">${subject.icon}</span>
      <span class="subject-name">${subject.name}</span>
      <span class="subject-count">${subject.chapters.length}</span>
      <span class="subject-arrow">▸</span>
    `;
    header.onclick = () => section.classList.toggle('open');
    
    const chapterList = document.createElement('div');
    chapterList.className = 'chapter-list';
    
    subject.chapters.forEach(chapter => {
      const status = getChapterStatus(chapter.id);
      const item = document.createElement('div');
      item.className = 'chapter-item';
      if (currentChapter === chapter.id) item.classList.add('active');
      
      item.innerHTML = `
        <div class="chapter-status ${status}">
          ${status === 'done' ? '✓' : status === 'in-progress' ? '⏳' : ''}
        </div>
        <span class="chapter-name">${chapter.name}</span>
      `;
      
      item.onclick = () => {
        currentChapter = chapter.id;
        showChapterDetails(chapter);
      };
      
      chapterList.appendChild(item);
    });
    
    section.appendChild(header);
    section.appendChild(chapterList);
    container.appendChild(section);
  });
}

function renderRoadmap() {
  const container = document.getElementById('roadmapContent');
  
  // If search is active, use search results
  if (isSearchActive) {
    renderSearchRoadmap();
    return;
  }
  
  container.innerHTML = '';
  
  Object.entries(knowledgeBase.learningPaths).forEach(([pathId, path]) => {
    const pathDiv = document.createElement('div');
    pathDiv.className = 'learning-path';
    
    pathDiv.innerHTML = `
      <div class="path-header">
        <h2 class="path-name">${path.name}</h2>
        <p class="path-desc">${path.description}</p>
      </div>
      <div class="path-steps"></div>
    `;
    
    const stepsContainer = pathDiv.querySelector('.path-steps');
    
    path.sequence.forEach((chapterId, index) => {
      const chapter = findChapter(chapterId);
      if (!chapter) return;
      
      const status = getChapterStatus(chapterId);
      const step = document.createElement('div');
      step.className = `path-step ${status}`;
      step.onclick = () => showChapterDetails(chapter);
      
      const priorityClass = chapter.priority ? `priority-${chapter.priority}` : 'priority-important';
      
      step.innerHTML = `
        <div class="step-number">${index + 1}</div>
        <div class="step-content">
          <div class="step-name">${chapter.name}</div>
          <div class="step-category">${chapter.category}</div>
          <div class="step-meta">
            <span class="step-badge ${priorityClass}">${chapter.priority || 'important'}</span>
            <span class="step-topics">${chapter.topics.length} topics</span>
          </div>
        </div>
      `;
      
      stepsContainer.appendChild(step);
    });
    
    container.appendChild(pathDiv);
  });
}

function renderTree() {
  const container = document.getElementById('treeContent');
  
  // If search is active, use search results
  if (isSearchActive) {
    renderSearchTree();
    return;
  }
  
  container.innerHTML = '';
  
  knowledgeBase.subjects.forEach(subject => {
    subject.chapters.forEach(chapter => {
      const status = getChapterStatus(chapter.id);
      const card = document.createElement('div');
      card.className = 'tree-chapter';
      card.dataset.priority = chapter.priority || 'important';
      card.dataset.status = status;
      
      const priorityClass = chapter.priority ? `priority-${chapter.priority}` : 'priority-important';
      
      card.innerHTML = `
        <div class="tree-chapter-header">
          <div>
            <div class="tree-chapter-name">${chapter.name}</div>
            <div class="tree-chapter-category">${subject.icon} ${chapter.category}</div>
          </div>
          <div class="tree-chapter-status ${status}" onclick="cycleStatus('${chapter.id}', event)"></div>
        </div>
        <div class="step-badge ${priorityClass}">${chapter.priority || 'important'}</div>
        <div class="tree-topics"></div>
      `;
      
      const topicsContainer = card.querySelector('.tree-topics');
      chapter.topics.slice(0, 5).forEach(topic => {
        const topicStatus = getTopicStatus(topic.id);
        const topicDiv = document.createElement('div');
        topicDiv.className = 'tree-topic';
        topicDiv.innerHTML = `
          <div class="topic-status ${topicStatus}" onclick="cycleTopicStatus('${topic.id}', event)"></div>
          <span class="topic-name">${topic.name}</span>
        `;
        topicsContainer.appendChild(topicDiv);
      });
      
      if (chapter.topics.length > 5) {
        const more = document.createElement('div');
        more.className = 'tree-topic';
        more.innerHTML = `<span style="color: var(--text3)">+ ${chapter.topics.length - 5} more topics...</span>`;
        more.onclick = () => showChapterDetails(chapter);
        topicsContainer.appendChild(more);
      }
      
      card.onclick = (e) => {
        if (!e.target.classList.contains('tree-chapter-status') && !e.target.classList.contains('topic-status')) {
          showChapterDetails(chapter);
        }
      };
      
      container.appendChild(card);
    });
  });
  
  applyFilters();
}

function renderList() {
  const container = document.getElementById('listContent');
  
  // If search is active, use search results
  if (isSearchActive) {
    renderSearchList();
    return;
  }
  
  container.innerHTML = '';
  
  const allChapters = [];
  knowledgeBase.subjects.forEach(subject => {
    subject.chapters.forEach(chapter => {
      allChapters.push({ ...chapter, subjectName: subject.name, subjectIcon: subject.icon });
    });
  });
  
  allChapters.forEach(chapter => {
    const status = getChapterStatus(chapter.id);
    const row = document.createElement('div');
    row.className = 'list-row';
    
    const priorityClass = chapter.priority ? `priority-${chapter.priority}` : 'priority-important';
    
    row.innerHTML = `
      <div class="row-check ${status}" onclick="cycleStatus('${chapter.id}', event)"></div>
      <div class="row-name">${chapter.name}</div>
      <div class="row-category">${chapter.subjectIcon} ${chapter.category}</div>
      <div class="row-priority">
        <span class="step-badge ${priorityClass}">${chapter.priority || 'important'}</span>
      </div>
      <div class="row-topics">${chapter.topics.length} topics</div>
      <div class="row-action">
        <button onclick="showChapterDetails(findChapter('${chapter.id}'))">View</button>
      </div>
    `;
    
    container.appendChild(row);
  });
}

function updateProgressStats() {
  const allChapters = [];
  knowledgeBase.subjects.forEach(subject => {
    subject.chapters.forEach(chapter => allChapters.push(chapter));
  });
  
  const done = allChapters.filter(ch => getChapterStatus(ch.id) === 'done').length;
  const inProgress = allChapters.filter(ch => getChapterStatus(ch.id) === 'in-progress').length;
  
  document.getElementById('doneCount').textContent = done;
  document.getElementById('inProgressCount').textContent = inProgress;
  document.getElementById('totalCount').textContent = allChapters.length;
}

// ============================================================
// INTERACTION
// ============================================================

let currentChapter = null;
let currentView = 'roadmap';
let activeFilters = { priority: 'all', status: 'all' };

function cycleStatus(chapterId, event) {
  event.stopPropagation();
  const current = getChapterStatus(chapterId);
  const next = current === 'not-started' ? 'in-progress' : current === 'in-progress' ? 'done' : 'not-started';
  setChapterStatus(chapterId, next);
}

function cycleTopicStatus(topicId, event) {
  event.stopPropagation();
  const current = getTopicStatus(topicId);
  const next = current === 'not-started' ? 'in-progress' : current === 'in-progress' ? 'done' : 'not-started';
  setTopicStatus(topicId, next);
}

function findChapter(chapterId) {
  for (const subject of knowledgeBase.subjects) {
    const chapter = subject.chapters.find(ch => ch.id === chapterId);
    if (chapter) return chapter;
  }
  return null;
}

function showChapterDetails(chapter) {
  const modal = document.getElementById('detailsModal');
  const title = document.getElementById('modalTitle');
  const body = document.getElementById('modalBody');
  
  title.textContent = chapter.name;
  
  const status = getChapterStatus(chapter.id);
  const notes = getChapterNotes(chapter.id);
  
  body.innerHTML = `
    <div class="details-section">
      <h3>Status & Progress</h3>
      <div style="display: flex; gap: 8px; margin-top: 8px;">
        <button class="btn ${status === 'not-started' ? 'btn-primary' : ''}" onclick="setChapterStatus('${chapter.id}', 'not-started'); showChapterDetails(findChapter('${chapter.id}'))">Not Started</button>
        <button class="btn ${status === 'in-progress' ? 'btn-primary' : ''}" onclick="setChapterStatus('${chapter.id}', 'in-progress'); showChapterDetails(findChapter('${chapter.id}'))">Learning</button>
        <button class="btn ${status === 'done' ? 'btn-primary' : ''}" onclick="setChapterStatus('${chapter.id}', 'done'); showChapterDetails(findChapter('${chapter.id}'))">Completed</button>
      </div>
    </div>
    
    <div class="details-section">
      <h3>Your Notes</h3>
      <textarea class="form-group textarea" id="chapterNotes" placeholder="Add your notes, links, thoughts..." style="width: 100%; min-height: 100px; background: var(--bg3); border: 1px solid var(--border2); border-radius: var(--radius); padding: 12px; color: var(--text); font-size: 13px; font-family: inherit;">${notes}</textarea>
      <button class="btn btn-primary" style="margin-top: 8px;" onclick="setChapterNotes('${chapter.id}', document.getElementById('chapterNotes').value); alert('Notes saved!')">Save Notes</button>
    </div>
    
    <div class="details-section">
      <h3>Topics (${chapter.topics.length})</h3>
      <div class="topic-list">
        ${chapter.topics.map(topic => `
          <div class="topic-item">
            <div class="topic-status ${getTopicStatus(topic.id)}" onclick="cycleTopicStatus('${topic.id}', event)"></div>
            <span class="topic-name">${topic.name}</span>
          </div>
        `).join('')}
      </div>
    </div>
    
    ${chapter.prerequisites && chapter.prerequisites.length > 0 ? `
      <div class="details-section">
        <h3>Prerequisites</h3>
        <p style="color: var(--text3); font-size: 13px;">Complete these chapters first: ${chapter.prerequisites.map(id => findChapter(id)?.name || id).join(', ')}</p>
      </div>
    ` : ''}
  `;
  
  modal.classList.add('open');
}

function closeModal(modalId) {
  document.getElementById(modalId).classList.remove('open');
}

function switchView(viewName) {
  currentView = viewName;
  
  document.querySelectorAll('.view-tab').forEach(tab => {
    tab.classList.toggle('active', tab.dataset.view === viewName);
  });
  
  document.querySelectorAll('.view-panel').forEach(panel => {
    panel.classList.toggle('active', panel.id === `${viewName}-view`);
  });
}

function applyFilters() {
  const cards = document.querySelectorAll('.tree-chapter');
  
  cards.forEach(card => {
    const priority = card.dataset.priority;
    const status = card.dataset.status;
    
    let show = true;
    
    if (activeFilters.priority !== 'all' && priority !== activeFilters.priority) {
      show = false;
    }
    
    if (activeFilters.status !== 'all' && status !== activeFilters.status) {
      show = false;
    }
    
    card.style.display = show ? 'block' : 'none';
  });
}

// ============================================================
// ADD/EDIT FUNCTIONALITY
// ============================================================

function saveChapter(event) {
  event.preventDefault();
  
  const subjectId = document.getElementById('addSubject').value;
  const name = document.getElementById('addName').value;
  const category = document.getElementById('addCategory').value;
  const priority = document.getElementById('addPriority').value;
  const topicsText = document.getElementById('addTopics').value;
  
  const topics = topicsText.split('\n').filter(t => t.trim()).map((topicName, index) => ({
    id: `${subjectId}-custom-${Date.now()}-${index}`,
    name: topicName.trim(),
    priority: 'important'
  }));
  
  const newChapter = {
    id: `${subjectId}-custom-${Date.now()}`,
    name,
    category,
    priority,
    prerequisites: [],
    topics
  };
  
  const subject = knowledgeBase.subjects.find(s => s.id === subjectId);
  if (subject) {
    subject.chapters.push(newChapter);
    saveKnowledgeBase();
    render();
    closeModal('addModal');
    alert('Chapter added successfully!');
    document.getElementById('addForm').reset();
  }
}

function saveKnowledgeBase() {
  // Save to localStorage as backup
  localStorage.setItem('knowledgeNavigator_data', JSON.stringify(knowledgeBase));
}

function loadSavedKnowledgeBase() {
  const saved = localStorage.getItem('knowledgeNavigator_data');
  if (saved) {
    knowledgeBase = JSON.parse(saved);
  }
}

// ============================================================
// EXPORT/IMPORT
// ============================================================

function exportJSON() {
  const data = {
    knowledgeBase,
    userProgress,
    exportedAt: new Date().toISOString()
  };
  
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `knowledge-navigator-backup-${Date.now()}.json`;
  a.click();
  URL.revokeObjectURL(url);
}

function exportCSV() {
  let csv = 'Subject,Chapter,Category,Priority,Status,Topics Count,Notes\n';
  
  knowledgeBase.subjects.forEach(subject => {
    subject.chapters.forEach(chapter => {
      const status = getChapterStatus(chapter.id);
      const notes = getChapterNotes(chapter.id).replace(/"/g, '""');
      csv += `"${subject.name}","${chapter.name}","${chapter.category}","${chapter.priority}","${status}","${chapter.topics.length}","${notes}"\n`;
    });
  });
  
  const blob = new Blob([csv], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `knowledge-navigator-${Date.now()}.csv`;
  a.click();
  URL.revokeObjectURL(url);
}

async function exportPDF() {
  alert('Generating PDF... This may take a moment.');
  
  // Create a printable version
  const printContent = document.createElement('div');
  printContent.style.cssText = 'padding: 40px; background: white; color: black; width: 800px;';
  
  let html = '<h1 style="margin-bottom: 20px;">Knowledge Navigator - Learning Progress</h1>';
  html += `<p style="margin-bottom: 30px; color: #666;">Generated on ${new Date().toLocaleString()}</p>`;
  
  knowledgeBase.subjects.forEach(subject => {
    html += `<h2 style="margin-top: 30px; color: #333;">${subject.icon} ${subject.name}</h2>`;
    
    subject.chapters.forEach(chapter => {
      const status = getChapterStatus(chapter.id);
      const statusIcon = status === 'done' ? '✅' : status === 'in-progress' ? '⏳' : '⬜';
      
      html += `<div style="margin: 15px 0; padding: 10px; border-left: 3px solid #ccc;">`;
      html += `<h3 style="margin: 0; font-size: 16px;">${statusIcon} ${chapter.name}</h3>`;
      html += `<p style="margin: 5px 0; color: #666; font-size: 13px;">${chapter.category} • ${chapter.topics.length} topics</p>`;
      
      const notes = getChapterNotes(chapter.id);
      if (notes) {
        html += `<p style="margin: 10px 0; font-size: 12px; color: #333; font-style: italic;">Notes: ${notes}</p>`;
      }
      
      html += `</div>`;
    });
  });
  
  printContent.innerHTML = html;
  document.body.appendChild(printContent);
  
  try {
    const canvas = await html2canvas(printContent);
    const imgData = canvas.toDataURL('image/png');
    
    const pdf = new jspdf.jsPDF('p', 'mm', 'a4');
    const imgWidth = 210;
    const pageHeight = 297;
    const imgHeight = (canvas.height * imgWidth) / canvas.width;
    let heightLeft = imgHeight;
    let position = 0;
    
    pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
    heightLeft -= pageHeight;
    
    while (heightLeft >= 0) {
      position = heightLeft - imgHeight;
      pdf.addPage();
      pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
      heightLeft -= pageHeight;
    }
    
    pdf.save(`knowledge-navigator-${Date.now()}.pdf`);
  } catch (error) {
    alert('PDF generation failed. Please try exporting to CSV instead.');
    console.error(error);
  } finally {
    document.body.removeChild(printContent);
  }
}

function importJSON() {
  document.getElementById('importInput').click();
}

function handleImport(event) {
  const file = event.target.files[0];
  if (!file) return;
  
  const reader = new FileReader();
  reader.onload = (e) => {
    try {
      const data = JSON.parse(e.target.result);
      
      if (data.knowledgeBase) {
        knowledgeBase = data.knowledgeBase;
        saveKnowledgeBase();
      }
      
      if (data.userProgress) {
        userProgress = data.userProgress;
        saveUserProgress();
      }
      
      render();
      alert('Data imported successfully!');
    } catch (error) {
      alert('Failed to import data. Please check the file format.');
      console.error(error);
    }
  };
  reader.readAsText(file);
}

// ============================================================
// SEARCH
// ============================================================

let searchResults = [];
let isSearchActive = false;

function setupSearch() {
  const input = document.getElementById('searchInput');
  
  input.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    
    if (!query) {
      clearSearch();
      return;
    }
    
    performSearch(query);
  });
}

function performSearch(query) {
  if (!knowledgeBase?.subjects) return;
  
  isSearchActive = true;
  searchResults = [];
  
  // Search through all subjects, chapters, and topics
  knowledgeBase.subjects.forEach(subject => {
    subject.chapters.forEach(chapter => {
      let chapterMatch = false;
      let matchingTopics = [];
      
      // Check if chapter name matches
      if (chapter.name.toLowerCase().includes(query) || 
          chapter.category?.toLowerCase().includes(query)) {
        chapterMatch = true;
      }
      
      // Check topics within the chapter
      if (chapter.topics) {
        chapter.topics.forEach(topic => {
          if (topic.name.toLowerCase().includes(query)) {
            matchingTopics.push(topic);
          }
        });
      }
      
      // If chapter matches or has matching topics, include it
      if (chapterMatch || matchingTopics.length > 0) {
        searchResults.push({
          subject: subject,
          chapter: chapter,
          matchType: chapterMatch ? 'chapter' : 'topics',
          matchingTopics: matchingTopics
        });
      }
    });
  });
  
  renderSearchResults();
}

function renderSearchResults() {
  const currentView = document.querySelector('.view-tab.active')?.dataset.view || 'roadmap';
  
  if (currentView === 'roadmap') {
    renderSearchRoadmap();
  } else if (currentView === 'tree') {
    renderSearchTree();
  } else if (currentView === 'list') {
    renderSearchList();
  }
}

function renderSearchRoadmap() {
  const container = document.getElementById('roadmapContent');
  if (!container) return;
  
  container.innerHTML = '';
  
  if (searchResults.length === 0) {
    const emptyDiv = document.createElement('div');
    emptyDiv.className = 'empty-state';
    emptyDiv.innerHTML = `
      <div class="empty-state-icon">🔍</div>
      <h3>No results found</h3>
      <p>Try different keywords or check spelling</p>
    `;
    container.appendChild(emptyDiv);
    return;
  }
  
  searchResults.forEach((result, index) => {
    const chapter = result.chapter;
    const status = getChapterStatus(chapter.id);
    
    const pathDiv = document.createElement('div');
    pathDiv.className = 'learning-path';
    
    pathDiv.innerHTML = `
      <div class="path-header">
        <h2 class="path-name">Search Result ${index + 1}: ${chapter.name}</h2>
        <p class="path-desc">${result.subject.name} • ${chapter.category} • ${chapter.topics?.length || 0} topics</p>
      </div>
      <div class="path-steps"></div>
    `;
    
    const stepsContainer = pathDiv.querySelector('.path-steps');
    const step = document.createElement('div');
    step.className = `path-step ${status}`;
    step.onclick = () => showChapterDetails(chapter);
    
    const priorityClass = chapter.priority ? `priority-${chapter.priority}` : 'priority-important';
    
    step.innerHTML = `
      <div class="step-number">${index + 1}</div>
      <div class="step-content">
        <div class="step-name">${chapter.name}</div>
        <div class="step-category">${result.subject.name} • ${chapter.category}</div>
        <div class="step-meta">
          <span class="step-badge ${priorityClass}">${chapter.priority || 'important'}</span>
          <span class="step-topics">${chapter.topics?.length || 0} topics</span>
          ${result.matchingTopics.length > 0 ? `<span class="step-topics">• ${result.matchingTopics.length} matching topics</span>` : ''}
        </div>
      </div>
    `;
    
    stepsContainer.appendChild(step);
    container.appendChild(pathDiv);
  });
}

function renderSearchTree() {
  const container = document.getElementById('treeContent');
  if (!container) return;
  
  container.innerHTML = '';
  
  if (searchResults.length === 0) {
    const emptyDiv = document.createElement('div');
    emptyDiv.className = 'empty-state';
    emptyDiv.innerHTML = `
      <div class="empty-state-icon">🔍</div>
      <h3>No results found</h3>
      <p>Try different keywords or check spelling</p>
    `;
    container.appendChild(emptyDiv);
    return;
  }
  
  searchResults.forEach(result => {
    const chapter = result.chapter;
    const status = getChapterStatus(chapter.id);
    
    const card = document.createElement('div');
    card.className = 'tree-chapter';
    
    const priorityClass = chapter.priority ? `priority-${chapter.priority}` : 'priority-important';
    
    card.innerHTML = `
      <div class="tree-chapter-header">
        <div>
          <div class="tree-chapter-name">${chapter.name}</div>
          <div class="tree-chapter-category">${result.subject.icon} ${chapter.category}</div>
        </div>
        <div class="tree-chapter-status ${status}" onclick="cycleStatus('${chapter.id}', event)"></div>
      </div>
      <div class="step-badge ${priorityClass}">${chapter.priority || 'important'}</div>
      <div class="tree-topics"></div>
    `;
    
    const topicsContainer = card.querySelector('.tree-topics');
    const topicsToShow = result.matchingTopics.length > 0 ? result.matchingTopics : (chapter.topics || []);
    
    topicsToShow.slice(0, 5).forEach(topic => {
      const topicStatus = getTopicStatus(topic.id);
      const topicDiv = document.createElement('div');
      topicDiv.className = 'tree-topic';
      topicDiv.innerHTML = `
        <div class="topic-status ${topicStatus}" onclick="cycleTopicStatus('${topic.id}', event)"></div>
        <span class="topic-name">${topic.name}</span>
      `;
      topicsContainer.appendChild(topicDiv);
    });
    
    if (topicsToShow.length > 5) {
      const more = document.createElement('div');
      more.className = 'tree-topic';
      more.innerHTML = `<span style="color: var(--text3)">+ ${topicsToShow.length - 5} more topics...</span>`;
      more.onclick = () => showChapterDetails(chapter);
      topicsContainer.appendChild(more);
    }
    
    card.onclick = (e) => {
      if (!e.target.classList.contains('tree-chapter-status') && !e.target.classList.contains('topic-status')) {
        showChapterDetails(chapter);
      }
    };
    
    container.appendChild(card);
  });
}

function renderSearchList() {
  const container = document.getElementById('listContent');
  if (!container) return;
  
  container.innerHTML = '';
  
  if (searchResults.length === 0) {
    const emptyDiv = document.createElement('div');
    emptyDiv.className = 'empty-state';
    emptyDiv.innerHTML = `
      <div class="empty-state-icon">🔍</div>
      <h3>No results found</h3>
      <p>Try different keywords or check spelling</p>
    `;
    container.appendChild(emptyDiv);
    return;
  }
  
  searchResults.forEach(result => {
    const chapter = result.chapter;
    const status = getChapterStatus(chapter.id);
    const row = document.createElement('div');
    row.className = 'list-row';
    
    const priorityClass = chapter.priority ? `priority-${chapter.priority}` : 'priority-important';
    
    row.innerHTML = `
      <div class="row-check ${status}" onclick="cycleStatus('${chapter.id}', event)"></div>
      <div class="row-name">${chapter.name}</div>
      <div class="row-category">${result.subject.icon} ${chapter.category}</div>
      <div class="row-priority">
        <span class="step-badge ${priorityClass}">${chapter.priority || 'important'}</span>
      </div>
      <div class="row-topics">${chapter.topics?.length || 0} topics</div>
      <div class="row-action">
        <button onclick="showChapterDetails(findChapter('${chapter.id}'))">View Details</button>
      </div>
    `;
    
    row.onclick = (e) => {
      if (!e.target.classList.contains('row-check') && !e.target.tagName === 'BUTTON') {
        showChapterDetails(chapter);
      }
    };
    
    container.appendChild(row);
  });
}

function clearSearch() {
  isSearchActive = false;
  searchResults = [];
  render(); // Re-render current view with full data
}

// ============================================================
// EVENT LISTENERS
// ============================================================

document.querySelectorAll('.view-tab').forEach(tab => {
  tab.addEventListener('click', () => switchView(tab.dataset.view));
});

document.getElementById('exportBtn').addEventListener('click', (e) => {
  e.stopPropagation();
  document.getElementById('exportMenu').classList.toggle('open');
});

document.addEventListener('click', (e) => {
  if (!e.target.closest('#exportBtn') && !e.target.closest('#exportMenu')) {
    document.getElementById('exportMenu').classList.remove('open');
  }
});

document.getElementById('addBtn').addEventListener('click', () => {
  document.getElementById('addModal').classList.add('open');
});

document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const filter = btn.dataset.filter;
    
    // Determine if it's priority or status filter
    if (['all', 'core', 'important', 'advanced', 'optional'].includes(filter)) {
      // Priority filter
      document.querySelectorAll('.filter-btn[data-filter="all"], .filter-btn[data-filter="core"], .filter-btn[data-filter="important"], .filter-btn[data-filter="advanced"], .filter-btn[data-filter="optional"]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilters.priority = filter === 'optional' ? 'optional' : filter;
    } else {
      // Status filter
      if (btn.classList.contains('active')) {
        btn.classList.remove('active');
        activeFilters.status = 'all';
      } else {
        document.querySelectorAll('.filter-btn[data-filter="done"], .filter-btn[data-filter="in-progress"], .filter-btn[data-filter="not-started"]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeFilters.status = filter;
      }
    }
    
    applyFilters();
  });
});

// Keyboard shortcut for search
document.addEventListener('keydown', (e) => {
  if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(e.target.tagName)) {
    e.preventDefault();
    document.getElementById('searchInput').focus();
  }
  
  if (e.key === 'Escape') {
    closeModal('detailsModal');
    closeModal('addModal');
  }
});

// ============================================================
// INITIALIZATION
// ============================================================

document.addEventListener('DOMContentLoaded', () => {
  loadSavedKnowledgeBase();
  loadKnowledgeBase(); // Now synchronous - data is embedded!
  setupSearch();
});
</script>

</body>
</html>
