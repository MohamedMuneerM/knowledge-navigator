        { "id": "e-fund-6", "name": "Linear algebra and matrix operations", "priority": "important" },
        { "id": "e-fund-7", "name": "Signal processing fundamentals", "priority": "core" },
        { "id": "e-fund-8", "name": "Sampling theorem and Nyquist rate", "priority": "core" },
        { "id": "e-fund-9", "name": "Control theory and PID controllers", "priority": "important" },
        { "id": "e-fund-10", "name": "Electromagnetics and Maxwell's equations", "priority": "important" },
        { "id": "e-fund-11", "name": "Semiconductor physics and PN junctions", "priority": "core" }
