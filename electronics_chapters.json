      "id": "e-fundamentals",
      "name": "Fundamentals & Mathematics",
      "category": "Foundation",
      "priority": "core",
      "prerequisites": [],
      "topics": [
        { "id": "e-fund-1", "name": "Circuit Theory (Ohm's law, Kirchhoff's laws, network theorems)", "priority": "core" },
        { "id": "e-fund-2", "name": "AC and DC circuit analysis", "priority": "core" },
        { "id": "e-fund-3", "name": "Complex numbers and phasors", "priority": "core" },
        { "id": "e-fund-4", "name": "Fourier transforms (continuous & discrete)", "priority": "important" },
